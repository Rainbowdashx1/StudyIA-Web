@page "/"
@implements IDisposable
@inject AppDatabase Db
@inject IJSRuntime JS

<PageTitle>StudyIA</PageTitle>

@* ── Main two-panel layout ── *@
<div class="flex h-screen overflow-hidden bg-white select-none">

    @* ── LEFT PANEL: Temarios list ── *@
    <div class="flex flex-col w-56 min-w-40 shrink-0 border-r border-gray-300">

        @* Header *@
        <div class="bg-gray-200 border-b border-gray-300 px-3 py-2">
            <span class="font-semibold text-sm">📚&nbsp; Temarios</span>
        </div>

        @* List *@
        <div class="flex-1 overflow-y-auto">
            @if (temarios.Count == 0)
            {
                <p class="p-4 text-gray-400 text-sm text-center">Sin temarios</p>
            }
            @foreach (var temario in temarios)
            {
                <div class="px-2 py-2 cursor-pointer border-b border-gray-100
                            @(selectedTemario == temario ? "bg-blue-100" : "hover:bg-gray-50")"
                     @onclick="() => OnTemarioSelected(temario)">
                    <div class="font-semibold text-sm truncate">@temario.Name</div>
                    <div class="text-xs text-gray-400 truncate">@temario.FolderPath</div>
                </div>
            }
        </div>

        @* Footer buttons *@
        <div class="bg-gray-100 border-t border-gray-300 px-2 py-2 flex gap-2">
            <button class="flex-1 h-7 text-xs border border-gray-300 rounded bg-white
                           hover:bg-gray-50 transition-colors"
                    @onclick="OnAddFolder">
                ＋ Añadir
            </button>
            <button class="flex-1 h-7 text-xs border border-gray-300 rounded bg-white
                           hover:bg-gray-50 transition-colors
                           disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(selectedTemario == null)"
                    @onclick="OnRemoveFolder">
                🗑 Eliminar
            </button>
        </div>

        @* Hidden folder picker input *@
        <input id="folderPickerInput" type="file" accept=".pdf"
               multiple webkitdirectory style="display:none" />

        @* Confirm remove *@
        @if (showConfirmRemove && selectedTemario is not null)
        {
            <div class="bg-red-50 border-t border-red-200 px-2 py-2 flex flex-col gap-1.5">
                <span class="text-xs text-red-700 font-medium">
                    ¿Eliminar "@selectedTemario.Name"?
                </span>
                <div class="flex gap-1">
                    <button class="flex-1 h-6 text-xs rounded bg-red-600 text-white
                                   hover:bg-red-700 transition-colors"
                            @onclick="ConfirmRemoveFolder">
                        Sí, eliminar
                    </button>
                    <button class="flex-1 h-6 text-xs border border-gray-300 rounded bg-white
                                   hover:bg-gray-50 transition-colors"
                            @onclick='() => showConfirmRemove = false'>
                        Cancelar
                    </button>
                </div>
            </div>
        }

    </div>

    @* Visual divider *@
    <div class="w-px bg-gray-300 shrink-0"></div>

    @* ── RIGHT PANEL ── *@
    <div class="flex flex-col flex-1 overflow-hidden">

        @* Toolbar *@
        <div class="bg-gray-100 border-b border-gray-300 px-3 py-2 flex items-center gap-2 flex-wrap">

            <span class="font-semibold text-gray-500 text-sm truncate max-w-xs mr-1">
                @(selectedTemario != null ? selectedTemario.Name : "← Selecciona o añade un temario")
            </span>

            <button class="h-8 px-3 text-sm font-semibold text-white bg-blue-600
                           hover:bg-blue-700 rounded transition-colors
                           disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(selectedTemario == null)"
                    @onclick="OnScan">
                🔄&nbsp; Escanear
            </button>

            <button class="h-8 px-3 text-sm border border-gray-300 rounded bg-white
                           hover:bg-gray-50 transition-colors
                           disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(selectedTemario == null)"
                    @onclick="OnOpenQuestions">
                📝&nbsp; Preguntas
            </button>

            <button class="h-8 px-3 text-sm font-semibold text-white bg-green-700
                           hover:bg-green-800 rounded transition-colors
                           disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(selectedTemario == null)"
                    @onclick="OnPractice">
                ▶&nbsp; Practicar
            </button>

        </div>

        @* PDF list area *@
        <div class="flex-1 overflow-auto relative">
            @if (selectedTemario == null || pdfFiles.Count == 0)
            {
                <div class="absolute inset-0 flex items-center justify-center">
                    <p class="text-gray-400 text-sm max-w-sm text-center px-4">
                        Selecciona un temario para ver sus archivos PDF.
                    </p>
                </div>
            }
            else
            {
                <table class="w-full text-sm border-collapse">
                    <thead class="bg-gray-50 sticky top-0 shadow-sm">
                        <tr>
                            <th class="text-left px-3 py-2 text-xs font-semibold text-gray-600
                                       uppercase tracking-wide border-b border-gray-200">
                                Archivo
                            </th>
                            <th class="text-left px-3 py-2 text-xs font-semibold text-gray-600
                                       uppercase tracking-wide border-b border-gray-200 w-28">
                                Estado
                            </th>
                            <th class="text-left px-3 py-2 text-xs font-semibold text-gray-600
                                       uppercase tracking-wide border-b border-gray-200 w-24">
                                Tamaño
                            </th>
                            <th class="text-left px-3 py-2 text-xs font-semibold text-gray-600
                                       uppercase tracking-wide border-b border-gray-200 w-28">
                                SHA-256
                            </th>
                            <th class="text-left px-3 py-2 text-xs font-semibold text-gray-600
                                       uppercase tracking-wide border-b border-gray-200 w-36">
                                Último scan
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (pdf, idx) in pdfFiles.Select((p, i) => (p, i)))
                        {
                            <tr class="@(idx % 2 == 0 ? "bg-white" : "bg-gray-50") hover:bg-blue-50 transition-colors cursor-default">
                                <td class="px-3 py-2 border-b border-gray-100">@pdf.FileName</td>
                                <td class="px-3 py-2 border-b border-gray-100">@pdf.Status</td>
                                <td class="px-3 py-2 border-b border-gray-100">@pdf.FileSizeDisplay</td>
                                <td class="px-3 py-2 border-b border-gray-100 font-mono text-xs">@pdf.HashShort</td>
                                <td class="px-3 py-2 border-b border-gray-100">@pdf.LastSeenDisplay</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* Status bar *@
        <div class="bg-gray-100 border-t border-gray-300 px-3 py-1.5 flex items-center justify-between">
            <span class="text-xs text-gray-500">@statusText</span>
            @if (isScanning)
            {
                <div class="w-40 h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500 rounded-full animate-pulse"></div>
                </div>
            }
        </div>

    </div>

</div>

@* Modal de preguntas *@
@if (showQuestionsModal)
{
    <GenerateQuestionsModal SelectedTemario="selectedTemario"
                            OnClose="OnQuestionsModalClose" />
}

@* Modal de evaluación (quiz) *@
@if (showQuizModal)
{
    <QuizModal SelectedTemario="selectedTemario"
               OnClose="OnQuizModalClose" />
}

@code {
    private List<TemarioModel> temarios      = new();
    private TemarioModel?      selectedTemario;
    private List<PdfFileModel> pdfFiles      = new();
    private string             statusText    = "Listo";
    private bool               isScanning         = false;
    private bool               showQuestionsModal  = false;
    private bool               showQuizModal       = false;
    private bool               showConfirmRemove   = false;
    private DotNetObjectReference<Home>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await Db.InitializeAsync();
        await LoadAllFoldersAsync(autoSelectFirst: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("folderPicker.init", "folderPickerInput", _dotNetRef);
        }
    }

    public void Dispose() => _dotNetRef?.Dispose();

    // ── Temarios ───────────────────────────────────────────────────────────

    private async Task LoadAllFoldersAsync(bool autoSelectFirst = false)
    {
        var records = Db.GetAllFolders();
        temarios = records.Select(f => new TemarioModel
        {
            Id         = f.Id,
            Name       = f.Name,
            FolderPath = f.FolderPath
        }).ToList();

        if (autoSelectFirst && selectedTemario is null && temarios.Count > 0)
            await OnTemarioSelected(temarios[0]);
    }

    private async Task OnTemarioSelected(TemarioModel temario)
    {
        selectedTemario   = temario;
        showConfirmRemove = false;
        await ScanFolderAsync();
    }

    // ── Añadir temario ─────────────────────────────────────────────────────

    private async Task OnAddFolder()
    {
        showConfirmRemove = false;
        await JS.InvokeVoidAsync("folderPicker.open", "folderPickerInput");
    }

    // Called from JS via DotNetObjectReference — avoids passing the FileList through Blazor's
    // event system which crashes the debug proxy when webkitdirectory selects many files.
    [JSInvokable]
    public async Task OnFolderSelectedCallback()
    {
        await OnFolderSelectedAsync();
        StateHasChanged();
    }

    private async Task OnFolderSelectedAsync()
    {
        // Obtener la lista de archivos seleccionados vía JS
        var files = await JS.InvokeAsync<List<JsFileInfo>>("folderPicker.getFileList", "folderPickerInput");
        if (files == null || files.Count == 0) return;

        // El nombre de la carpeta raíz viene en la primera parte del relativePath: "carpeta/archivo.pdf"
        var folderName = files[0].RelativePath.Split('/')[0];
        // Usamos el folderName como identificador virtual de la carpeta
        var folderPath = folderName;

        await Db.AddFolderAsync(folderName, folderPath);
        await LoadAllFoldersAsync();

        var added = temarios.FirstOrDefault(t => t.FolderPath == folderPath);
        if (added is not null)
            await OnTemarioSelected(added);
    }

    // ── Eliminar temario ───────────────────────────────────────────────────

    private void OnRemoveFolder()
    {
        if (selectedTemario is null) return;
        showConfirmRemove = true;
    }

    private async Task ConfirmRemoveFolder()
    {
        if (selectedTemario is null) return;

        await Db.DeleteFolderAsync(selectedTemario.Id);
        selectedTemario   = null;
        showConfirmRemove = false;
        pdfFiles.Clear();
        statusText = "Listo";

        await LoadAllFoldersAsync();
    }

    // ── Escanear ───────────────────────────────────────────────────────────

    private async Task OnScan() => await ScanFolderAsync();

    private async Task ScanFolderAsync()
    {
        if (selectedTemario is null) return;

        var folderPath = selectedTemario.FolderPath;

        // Obtener los archivos PDF del input que corresponden a esta carpeta
        var allFiles = await JS.InvokeAsync<List<JsFileInfo>>("folderPicker.getFileList", "folderPickerInput");
        var pdfs = allFiles
            .Where(f => f.RelativePath.Split('/')[0] == folderPath
                     && f.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (pdfs.Count == 0)
        {
            pdfFiles.Clear();
            statusText = "No se encontraron archivos PDF. Selecciona la carpeta con el botón Añadir.";
            return;
        }

        isScanning = true;
        statusText = "Escaneando...";
        StateHasChanged();

        var results = new List<PdfFileModel>();
        try
        {
            for (var i = 0; i < pdfs.Count; i++)
            {
                var file = pdfs[i];
                statusText = $"Procesando {file.Name}  ({i + 1}/{pdfs.Count})...";
                StateHasChanged();
                var result = await ProcessPdfAsync(file, folderPath);
                results.Add(result);
            }

            pdfFiles = results;

            var newCount      = results.Count(r => r.RawStatus == PdfStatus.New);
            var modifiedCount = results.Count(r => r.RawStatus == PdfStatus.Modified);
            statusText = $"{results.Count} PDF(s) escaneado(s)" +
                         (newCount      > 0 ? $"  -  {newCount} nuevo(s)"           : "") +
                         (modifiedCount > 0 ? $"  -  {modifiedCount} modificado(s)" : "") +
                         ".";
        }
        catch (Exception ex)
        {
            statusText = $"Error al escanear: {ex.Message}";
        }
        finally
        {
            isScanning = false;
        }
    }

    private async Task<PdfFileModel> ProcessPdfAsync(JsFileInfo file, string folderPath)
    {
        try
        {
            // Fingerprint basado en metadatos (nombre + tamaño + lastModified).
            // Leer el contenido completo de cada PDF vía JSInterop agota el heap de WASM
            // (cada PDF grande genera decenas de MB de string base64 + bytes decodificados),
            // lo que provoca que el proceso de debug termine con código -1.
            var metaBytes   = System.Text.Encoding.UTF8.GetBytes(
                                  $"{file.Name}|{file.Size}|{file.LastModified}");
            var fingerprint = Convert.ToHexString(SHA256.HashData(metaBytes));
            var fileSize    = file.Size;

            var storedHash = Db.GetStoredHash(file.Name + "|" + folderPath);
            var status = storedHash is null
                       ? PdfStatus.New
                       : storedHash == fingerprint ? PdfStatus.Unchanged
                                                   : PdfStatus.Modified;

            await Db.UpsertPdfFileAsync(folderPath, file.Name + "|" + folderPath,
                                        file.Name, fingerprint, fileSize);
            return new PdfFileModel(file.Name, fileSize, fingerprint, status);
        }
        catch (Exception ex)
        {
            return new PdfFileModel(file.Name, 0, string.Empty, PdfStatus.New, ex.Message);
        }
    }

    // ── Modales ────────────────────────────────────────────────────────────

    private void OnOpenQuestions() => showQuestionsModal = true;
    private void OnPractice()      => showQuizModal      = true;
    private void OnQuizModalClose()      => showQuizModal      = false;
    private void OnQuestionsModalClose() => showQuestionsModal = false;

    // ── JS interop types ───────────────────────────────────────────────────

    private sealed class JsFileInfo
    {
        public int    Index        { get; set; }
        public string Name         { get; set; } = string.Empty;
        public string RelativePath { get; set; } = string.Empty;
        public long   Size         { get; set; }
        public long   LastModified { get; set; }
    }
}
