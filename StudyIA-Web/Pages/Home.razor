@page "/"
@implements IDisposable
@inject AppDatabase Db
@inject IJSRuntime JS

<PageTitle>StudyIA</PageTitle>

<div class="flex h-screen overflow-hidden bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 select-none">

    @* ── SIDEBAR ── *@
    <aside class="flex flex-col w-60 shrink-0 bg-white dark:bg-zinc-900 border-r border-zinc-200 dark:border-zinc-800">

        @* Brand *@
        <div class="px-5 pt-5 pb-4 border-b border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
                <span class="font-bold text-sm tracking-tight text-zinc-800 dark:text-zinc-100">StudyIA</span>
            </div>
            <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-2.5 font-medium uppercase tracking-wider">Temarios</p>
        </div>

        @* List *@
        <div class="flex-1 overflow-y-auto py-1.5">
            @if (temarios.Count == 0)
            {
                <div class="flex flex-col items-center gap-2 px-5 py-8 text-center">
                    <svg class="w-8 h-8 text-zinc-300 dark:text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
                    </svg>
                    <p class="text-xs text-zinc-400 dark:text-zinc-600">Sin temarios todavía</p>
                </div>
            }
            @foreach (var temario in temarios)
            {
                <button class="w-full text-left px-4 py-2.5 transition-all border-l-2
                               @(selectedTemario == temario
                                   ? "bg-indigo-50 dark:bg-indigo-950/40 border-indigo-500 text-indigo-700 dark:text-indigo-300"
                                   : "border-transparent hover:bg-zinc-50 dark:hover:bg-zinc-800/60 text-zinc-700 dark:text-zinc-300")"
                         @onclick="() => OnTemarioSelected(temario)">
                    <div class="font-medium text-sm truncate">@temario.Name</div>
                    <div class="text-xs text-zinc-400 dark:text-zinc-500 truncate mt-0.5">@temario.FolderPath</div>
                </button>
            }
        </div>

        @* Actions *@
        <div class="px-4 py-3 border-t border-zinc-100 dark:border-zinc-800 space-y-1.5">
            <button class="w-full h-8 text-xs font-semibold rounded-lg bg-indigo-600 text-white
                           hover:bg-indigo-700 active:bg-indigo-800 transition-colors flex items-center justify-center gap-1.5"
                    @onclick="OnAddFolder">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Añadir temario
            </button>
            <button class="w-full h-8 text-xs font-medium rounded-lg border border-zinc-200 dark:border-zinc-700
                           text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800
                           transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-1.5"
                    disabled="@(selectedTemario == null)"
                    @onclick="OnRemoveFolder">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
                Eliminar
            </button>
        </div>

        @* Hidden folder picker *@
        <input id="folderPickerInput" type="file" accept=".pdf"
               multiple webkitdirectory style="display:none" />

        @* Confirm remove *@
        @if (showConfirmRemove && selectedTemario is not null)
        {
            <div class="mx-3 mb-3 p-3 bg-red-50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
                <p class="text-xs text-red-700 dark:text-red-400 mb-2 font-medium leading-relaxed">
                    ¿Eliminar <span class="font-semibold">"@selectedTemario.Name"</span>?
                </p>
                <div class="flex gap-1.5">
                    <button class="flex-1 h-7 text-xs font-medium rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors"
                            @onclick="ConfirmRemoveFolder">
                        Eliminar
                    </button>
                    <button class="flex-1 h-7 text-xs font-medium rounded-lg border border-zinc-200 dark:border-zinc-700
                                   text-zinc-500 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
                            @onclick='() => showConfirmRemove = false'>
                        Cancelar
                    </button>
                </div>
            </div>
        }

    </aside>

    @* ── MAIN CONTENT ── *@
    <div class="flex flex-col flex-1 overflow-hidden">

        @* Top bar *@
        <header class="flex items-center gap-3 px-6 py-3 bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 shrink-0">
            <div class="flex-1 min-w-0">
                <h1 class="text-sm font-semibold text-zinc-800 dark:text-zinc-100 truncate leading-tight">
                    @(selectedTemario != null ? selectedTemario.Name : "Selecciona un temario")
                </h1>
                @if (selectedTemario == null)
                {
                    <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">Elige o añade un temario desde el panel izquierdo</p>
                }
            </div>

            <div class="flex items-center gap-1.5">
                <button class="h-8 px-3 text-xs font-medium rounded-lg bg-zinc-100 dark:bg-zinc-800
                               text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700
                               transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
                        disabled="@(selectedTemario == null)"
                        @onclick="OnScan">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    Escanear
                </button>

                <button class="h-8 px-3 text-xs font-medium rounded-lg border border-zinc-200 dark:border-zinc-700
                               text-zinc-600 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800
                               transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
                        disabled="@(selectedTemario == null)"
                        @onclick="OnOpenQuestions">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V19.5a2.25 2.25 0 002.25 2.25h.75" />
                    </svg>
                    Preguntas
                </button>

                <button class="h-8 px-3 text-xs font-semibold rounded-lg bg-indigo-600 text-white
                               hover:bg-indigo-700 active:bg-indigo-800 transition-colors
                               disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
                        disabled="@(selectedTemario == null)"
                        @onclick="OnPractice">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5.14v14l11-7-11-7z" />
                    </svg>
                    Practicar
                </button>

                <div class="w-px h-5 bg-zinc-200 dark:bg-zinc-700 mx-0.5"></div>

                <button class="h-8 w-8 rounded-lg flex items-center justify-center
                               text-zinc-400 dark:text-zinc-500
                               hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-600 dark:hover:text-zinc-300
                               transition-colors"
                        title="@(isDark ? "Modo claro" : "Modo oscuro")"
                        @onclick="ToggleTheme">
                    @if (isDark)
                    {
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                        </svg>
                    }
                    else
                    {
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                        </svg>
                    }
                </button>
            </div>
        </header>

        @* Content area *@
        <div class="flex-1 overflow-auto relative">
            @if (selectedTemario == null || pdfFiles.Count == 0)
            {
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 pointer-events-none">
                    <div class="w-14 h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 flex items-center justify-center">
                        <svg class="w-7 h-7 text-zinc-300 dark:text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                        </svg>
                    </div>
                    <div class="text-center">
                        <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">
                            @(selectedTemario == null ? "Ningún temario seleccionado" : "Sin archivos PDF")
                        </p>
                        <p class="text-xs text-zinc-400 dark:text-zinc-600 mt-1 max-w-xs leading-relaxed">
                            @(selectedTemario == null
                                ? "Selecciona o añade un temario desde el panel izquierdo."
                                : "Pulsa Escanear para cargar los archivos de este temario.")
                        </p>
                    </div>
                </div>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead class="bg-white dark:bg-zinc-900 sticky top-0 shadow-[0_1px_0_0_theme(colors.zinc.200)] dark:shadow-[0_1px_0_0_theme(colors.zinc.800)]">
                        <tr>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Archivo</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider w-28">Estado</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider w-24">Tamaño</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider w-28">SHA-256</th>
                            <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider w-36">Último scan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                        @foreach (var pdf in pdfFiles)
                        {
                            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors">
                                <td class="px-6 py-3 text-zinc-800 dark:text-zinc-200 font-medium">@pdf.FileName</td>
                                <td class="px-6 py-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @GetStatusBadgeClass(pdf.RawStatus)">
                                        @pdf.Status
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-zinc-500 dark:text-zinc-400 tabular-nums">@pdf.FileSizeDisplay</td>
                                <td class="px-6 py-3 font-mono text-xs text-zinc-400 dark:text-zinc-500">@pdf.HashShort</td>
                                <td class="px-6 py-3 text-zinc-500 dark:text-zinc-400 tabular-nums">@pdf.LastSeenDisplay</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* Status bar *@
        <footer class="flex items-center gap-2.5 px-6 py-2 bg-white dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800 shrink-0">
            @if (isScanning)
            {
                <span class="relative flex h-2 w-2 shrink-0">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                </span>
            }
            <span class="text-xs text-zinc-400 dark:text-zinc-500 truncate flex-1">@statusText</span>
            @if (isScanning)
            {
                <div class="w-28 h-1 bg-zinc-200 dark:bg-zinc-700 rounded-full overflow-hidden shrink-0">
                    <div class="h-full w-1/2 bg-indigo-500 rounded-full animate-pulse"></div>
                </div>
            }
        </footer>

    </div>

</div>

@if (showQuestionsModal)
{
    <GenerateQuestionsModal SelectedTemario="selectedTemario"
                            OnClose="OnQuestionsModalClose" />
}

@if (showQuizModal)
{
    <QuizModal SelectedTemario="selectedTemario"
               OnClose="OnQuizModalClose" />
}

@code {
    private List<TemarioModel> temarios      = new();
    private TemarioModel?      selectedTemario;
    private List<PdfFileModel> pdfFiles      = new();
    private string             statusText    = "Listo";
    private bool               isScanning         = false;
    private bool               showQuestionsModal  = false;
    private bool               showQuizModal       = false;
    private bool               showConfirmRemove   = false;
    private bool               isDark             = true;
    private DotNetObjectReference<Home>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await Db.InitializeAsync();
        await LoadAllFoldersAsync(autoSelectFirst: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("folderPicker.init", "folderPickerInput", _dotNetRef);
            isDark = await JS.InvokeAsync<bool>("themeManager.isDark");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDark = await JS.InvokeAsync<bool>("themeManager.toggle");
    }

    public void Dispose() => _dotNetRef?.Dispose();

    // ── Temarios ───────────────────────────────────────────────────────────

    private async Task LoadAllFoldersAsync(bool autoSelectFirst = false)
    {
        var records = Db.GetAllFolders();
        temarios = records.Select(f => new TemarioModel
        {
            Id         = f.Id,
            Name       = f.Name,
            FolderPath = f.FolderPath
        }).ToList();

        if (autoSelectFirst && selectedTemario is null && temarios.Count > 0)
            await OnTemarioSelected(temarios[0]);
    }

    private async Task OnTemarioSelected(TemarioModel temario)
    {
        selectedTemario   = temario;
        showConfirmRemove = false;
        await ScanFolderAsync();
    }

    // ── Añadir temario ─────────────────────────────────────────────────────

    private async Task OnAddFolder()
    {
        showConfirmRemove = false;
        await JS.InvokeVoidAsync("folderPicker.open", "folderPickerInput");
    }

    // Called from JS via DotNetObjectReference — avoids passing the FileList through Blazor's
    // event system which crashes the debug proxy when webkitdirectory selects many files.
    [JSInvokable]
    public async Task OnFolderSelectedCallback()
    {
        await OnFolderSelectedAsync();
        StateHasChanged();
    }

    private async Task OnFolderSelectedAsync()
    {
        // Obtener la lista de archivos seleccionados vía JS
        var files = await JS.InvokeAsync<List<JsFileInfo>>("folderPicker.getFileList", "folderPickerInput");
        if (files == null || files.Count == 0) return;

        // El nombre de la carpeta raíz viene en la primera parte del relativePath: "carpeta/archivo.pdf"
        var folderName = files[0].RelativePath.Split('/')[0];
        // Usamos el folderName como identificador virtual de la carpeta
        var folderPath = folderName;

        await Db.AddFolderAsync(folderName, folderPath);
        await LoadAllFoldersAsync();

        var added = temarios.FirstOrDefault(t => t.FolderPath == folderPath);
        if (added is not null)
            await OnTemarioSelected(added);
    }

    // ── Eliminar temario ───────────────────────────────────────────────────

    private void OnRemoveFolder()
    {
        if (selectedTemario is null) return;
        showConfirmRemove = true;
    }

    private async Task ConfirmRemoveFolder()
    {
        if (selectedTemario is null) return;

        await Db.DeleteFolderAsync(selectedTemario.Id);
        selectedTemario   = null;
        showConfirmRemove = false;
        pdfFiles.Clear();
        statusText = "Listo";

        await LoadAllFoldersAsync();
    }

    // ── Escanear ───────────────────────────────────────────────────────────

    private async Task OnScan() => await ScanFolderAsync();

    private async Task ScanFolderAsync()
    {
        if (selectedTemario is null) return;

        var folderPath = selectedTemario.FolderPath;

        // Obtener los archivos PDF del input que corresponden a esta carpeta
        var allFiles = await JS.InvokeAsync<List<JsFileInfo>>("folderPicker.getFileList", "folderPickerInput");
        var pdfs = allFiles
            .Where(f => f.RelativePath.Split('/')[0] == folderPath
                     && f.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (pdfs.Count == 0)
        {
            // El <input type="file"> se resetea al recargar la página.
            // Mostramos los registros guardados en localStorage para que el usuario
            // vea sus PDFs aunque no haya vuelto a seleccionar la carpeta.
            var stored = Db.GetFilesInFolder(folderPath);
            if (stored.Count > 0)
            {
                pdfFiles   = stored.Select(r => new PdfFileModel(
                                 r.FileName, r.FileSize, r.FileHash,
                                 PdfStatus.Unchanged, lastSeen: r.LastSeen)).ToList();
                statusText = $"{stored.Count} PDF(s) en caché · pulsa 🔄 Escanear tras seleccionar la carpeta para actualizar.";
            }
            else
            {
                pdfFiles.Clear();
                statusText = "No se encontraron archivos PDF. Selecciona la carpeta con el botón Añadir.";
            }
            return;
        }

        isScanning = true;
        statusText = "Escaneando...";
        StateHasChanged();

        var results = new List<PdfFileModel>();
        try
        {
            for (var i = 0; i < pdfs.Count; i++)
            {
                var file = pdfs[i];
                statusText = $"Procesando {file.Name}  ({i + 1}/{pdfs.Count})...";
                StateHasChanged();
                var result = await ProcessPdfAsync(file, folderPath);
                results.Add(result);
            }

            pdfFiles = results;

            var newCount      = results.Count(r => r.RawStatus == PdfStatus.New);
            var modifiedCount = results.Count(r => r.RawStatus == PdfStatus.Modified);
            statusText = $"{results.Count} PDF(s) escaneado(s)" +
                         (newCount      > 0 ? $"  -  {newCount} nuevo(s)"           : "") +
                         (modifiedCount > 0 ? $"  -  {modifiedCount} modificado(s)" : "") +
                         ".";
        }
        catch (Exception ex)
        {
            statusText = $"Error al escanear: {ex.Message}";
        }
        finally
        {
            isScanning = false;
        }
    }

    private async Task<PdfFileModel> ProcessPdfAsync(JsFileInfo file, string folderPath)
    {
        try
        {
            // Fingerprint basado en metadatos (nombre + tamaño + lastModified).
            // Leer el contenido completo de cada PDF vía JSInterop agota el heap de WASM
            // (cada PDF grande genera decenas de MB de string base64 + bytes decodificados),
            // lo que provoca que el proceso de debug termine con código -1.
            var metaBytes   = System.Text.Encoding.UTF8.GetBytes(
                                  $"{file.Name}|{file.Size}|{file.LastModified}");
            var fingerprint = Convert.ToHexString(SHA256.HashData(metaBytes));
            var fileSize    = file.Size;

            var storedHash = Db.GetStoredHash(file.Name + "|" + folderPath);
            var status = storedHash is null
                       ? PdfStatus.New
                       : storedHash == fingerprint ? PdfStatus.Unchanged
                                                   : PdfStatus.Modified;

            await Db.UpsertPdfFileAsync(folderPath, file.Name + "|" + folderPath,
                                        file.Name, fingerprint, fileSize);
            return new PdfFileModel(file.Name, fileSize, fingerprint, status);
        }
        catch (Exception ex)
        {
            return new PdfFileModel(file.Name, 0, string.Empty, PdfStatus.New, ex.Message);
        }
    }

    // ── Modales ────────────────────────────────────────────────────────────

    private void OnOpenQuestions() => showQuestionsModal = true;
    private void OnPractice()      => showQuizModal      = true;
    private void OnQuizModalClose()      => showQuizModal      = false;
    private void OnQuestionsModalClose() => showQuestionsModal = false;

    // ── Helpers ────────────────────────────────────────────────────────────

    private static string GetStatusBadgeClass(PdfStatus status) => status switch
    {
        PdfStatus.New       => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-400",
        PdfStatus.Modified  => "bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400",
        PdfStatus.Unchanged => "bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400",
        _                   => "bg-red-100 text-red-600 dark:bg-red-950/50 dark:text-red-400"
    };

    // ── JS interop types ───────────────────────────────────────────────────

    private sealed class JsFileInfo
    {
        public int    Index        { get; set; }
        public string Name         { get; set; } = string.Empty;
        public string RelativePath { get; set; } = string.Empty;
        public long   Size         { get; set; }
        public long   LastModified { get; set; }
    }
}
